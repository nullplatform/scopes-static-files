#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
source "$SCRIPT_DIR/../../scripts/get_config_value"

echo "🔍 Validating Cloudflare network configuration..."
echo ""

zone_id=$(get_config_value \
	--provider '.providers["scope-configurations"].network.cloudflare_zone_id')

if [ -z "$zone_id" ]; then
	echo "   ❌ cloudflare_zone_id is not configured"
	echo ""
	echo "  💡 Possible causes:"
	echo "    • The scope-configurations provider is missing 'network.cloudflare_zone_id'"
	echo ""
	echo "  🔧 How to fix:"
	echo "    • Set 'network.cloudflare_zone_id' in the scope-configurations provider"
	echo "    • The zone ID is on the zone's Overview page in the Cloudflare dashboard"
	echo ""
	exit 1
fi
echo "   ✅ zone_id=$zone_id"

# The token is a secret, so it never comes from the scope configuration: the
# worker gets it from its environment, the same place the Cloudflare provider
# reads it from.
if [ -z "${CLOUDFLARE_API_TOKEN:-}" ]; then
	echo "   ❌ CLOUDFLARE_API_TOKEN is not set"
	echo ""
	echo "  💡 Possible causes:"
	echo "    • The worker that runs this scope was not given a Cloudflare API token"
	echo ""
	echo "  🔧 How to fix:"
	echo "    • Expose CLOUDFLARE_API_TOKEN to the scope's worker from a secret"
	echo "    • The token needs 'Zone:Read' and 'DNS:Edit' on the zone"
	echo ""
	exit 1
fi
echo "   ✅ CLOUDFLARE_API_TOKEN is set"

proxied=$(get_config_value \
	--provider '.providers["scope-configurations"].network.cloudflare_proxied' \
	--default "false")

if [ "$proxied" != "true" ] && [ "$proxied" != "false" ]; then
	echo "   ❌ cloudflare_proxied must be true or false, got '$proxied'"
	echo ""
	echo "  🔧 How to fix:"
	echo "    • Set 'network.cloudflare_proxied' to true or false in the scope-configurations provider"
	echo ""
	exit 1
fi
echo "   ✅ proxied=$proxied"

application_slug=$(echo "$CONTEXT" | jq -r .application.slug)
scope_slug=$(echo "$CONTEXT" | jq -r .scope.slug)
scope_id=$(echo "$CONTEXT" | jq -r .scope.id)

echo ""
echo "   📡 Fetching domain from Cloudflare zone..."

cloudflare_api_url="${CLOUDFLARE_API_BASE_URL:-https://api.cloudflare.com/client/v4}"

# The Authorization header goes in through stdin rather than as an argument,
# so the token does not show up in the process list. Cloudflare answers errors
# with a JSON body, so the exit code alone says little: -w appends the status.
cf_stderr_file=$(mktemp)
cf_output=$(printf 'header = "Authorization: Bearer %s"\n' "$CLOUDFLARE_API_TOKEN" |
	curl --silent --show-error --max-time 30 --config - \
		--write-out '\n%{http_code}' \
		"$cloudflare_api_url/zones/$zone_id" 2>"$cf_stderr_file") && cf_exit_code=0 || cf_exit_code=$?
cf_stderr=$(cat "$cf_stderr_file")
rm -f "$cf_stderr_file"

cf_http_code=$(echo "$cf_output" | tail -n 1)
cf_body=$(echo "$cf_output" | sed '$d')

if [ "$cf_exit_code" -ne 0 ] || [ "$cf_http_code" != "200" ]; then
	echo ""
	echo "   ❌ Failed to fetch Cloudflare zone information"
	echo ""

	if [ "$cf_exit_code" -ne 0 ]; then
		echo "  🌐 Error: Could not reach the Cloudflare API"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • The worker has no outbound access to $cloudflare_api_url"
		echo ""
		echo "  📋 Error details:"
		echo "$cf_stderr" | sed 's/^/    /'

	elif [ "$cf_http_code" = "401" ] || [ "$cf_http_code" = "403" ]; then
		echo "  🔒 Error: Cloudflare rejected the API token (HTTP $cf_http_code)"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • The token is invalid, expired or was revoked"
		echo "    • The token is not allowed on zone '$zone_id'"
		echo "    • The token is missing the 'Zone:Read' permission"
		echo ""
		echo "  🔧 How to fix:"
		echo "    1. Verify the token: GET $cloudflare_api_url/user/tokens/verify"
		echo "    2. Ensure the token has 'Zone:Read' and 'DNS:Edit' on the zone"

	elif [ "$cf_http_code" = "400" ] || [ "$cf_http_code" = "404" ]; then
		echo "  🔎 Error: Zone '$zone_id' was not found (HTTP $cf_http_code)"
		echo ""
		echo "  💡 Possible causes:"
		echo "    • The zone ID is incorrect or has a typo"
		echo "    • The zone belongs to another Cloudflare account"
		echo "    • A zone name was configured instead of the zone ID"
		echo ""
		echo "  🔧 How to fix:"
		echo "    1. Copy the zone ID from the zone's Overview page in the Cloudflare dashboard"
		echo "    2. Update 'network.cloudflare_zone_id' in the scope-configurations provider"

	else
		echo "  📋 Error details (HTTP $cf_http_code):"
		(echo "$cf_body" | jq -r '.errors[]? | "\(.code): \(.message)"' 2>/dev/null || echo "$cf_body") | sed 's/^/    /'
	fi

	echo ""
	exit 1
fi

network_domain=$(echo "$cf_body" | jq -r '.result.name // empty' 2>/dev/null || true)

if [ -z "$network_domain" ] || [ "$network_domain" = "null" ]; then
	echo ""
	echo "   ❌ Failed to extract domain name from Cloudflare zone response"
	echo ""
	echo "  💡 Possible causes:"
	echo "    • The Cloudflare API answered without a zone name"
	echo ""
	echo "  🔧 How to fix:"
	echo "    1. Verify the zone: GET $cloudflare_api_url/zones/$zone_id"
	echo ""
	exit 1
fi

echo "   ✅ domain=$network_domain"

network_subdomain="$application_slug-$scope_slug"
echo "   ✅ subdomain=$network_subdomain"

TOFU_VARIABLES=$(echo "$TOFU_VARIABLES" | jq \
	--arg zone_id "$zone_id" \
	--arg domain "$network_domain" \
	--arg subdomain "$network_subdomain" \
	--argjson proxied "$proxied" \
	'. + {
    network_cloudflare_zone_id: $zone_id,
    network_domain: $domain,
    network_subdomain: $subdomain,
    network_cloudflare_proxied: $proxied
  }')

scope_domain="$network_subdomain.$network_domain"

# A destroy (delete-scope) must not touch the scope record: the scope is
# going away, and a failed patch would leave its resources behind.
if [ "${TOFU_ACTION:-}" = "destroy" ]; then
	echo ""
	echo "   ⏭️  Not setting the scope domain: the scope's resources are being destroyed"
else
	echo ""
	echo "   📝 Setting scope domain to '$scope_domain'..."

	np_output=$(np scope patch --id "$scope_id" --body "{\"domain\":\"$scope_domain\"}" --format json 2>&1) && np_exit_code=0 || np_exit_code=$?

	if [ "$np_exit_code" -ne 0 ]; then
		echo ""
		echo "   ❌ Failed to update scope domain"
		echo ""

		if echo "$np_output" | grep -q "unauthorized\|forbidden\|401\|403"; then
			echo "  🔒 Error: Permission denied"
			echo ""
			echo "  💡 Possible causes:"
			echo "    • The nullplatform API Key doesn't have 'Developer' permissions"
			echo ""
			echo "  🔧 How to fix:"
			echo "    1. Ensure the API Key has 'Developer' permissions at the correct NRN hierarchy level"

		else
			echo "  📋 Error details:"
			echo "$np_output" | sed 's/^/    /'
		fi

		echo ""
		exit 1
	fi

	echo "   ✅ Scope domain set successfully"
fi

echo ""
echo "✨ Cloudflare network configured successfully"
echo ""

# Add module to composition list
script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module_name="${script_dir}/modules"

if [[ -n $MODULES_TO_USE ]]; then
	MODULES_TO_USE="$MODULES_TO_USE,$module_name"
else
	MODULES_TO_USE="$module_name"
fi
