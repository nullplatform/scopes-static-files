#!/bin/bash

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=/dev/null
source "$SCRIPT_DIR/../../scripts/get_config_value"

echo "🔍 Validating Azure Front Door distribution configuration..."

application_slug=$(echo "$CONTEXT" | jq -r .application.slug)
scope_slug=$(echo "$CONTEXT" | jq -r .scope.slug)
scope_id=$(echo "$CONTEXT" | jq -r .scope.id)
phase="${STATIC_FILES_PHASE:-deployment-apply}"

distribution_app_name="$application_slug-$scope_slug-$scope_id"
echo "   ✅ app_name=$distribution_app_name"

# Storage account the scope serves from. Required when the scope creates or
# destroys its resources (no asset then); optional on deployments, where it
# guards against an asset uploaded to another account.
assets_storage_account=$(get_config_value \
  --provider '.providers["scope-configurations"].distribution.azure_assets_storage_account' \
  --env AZURE_ASSETS_STORAGE_ACCOUNT)

if [[ "$phase" == scope-* ]]; then
  # =============================================================================
  # Scope phase: no asset yet. The route points at a prefix with no blobs, so
  # the domain answers 404 until the first deployment, and never serves another
  # application's bundles from the shared container.
  # =============================================================================
  if [ -z "$assets_storage_account" ] && [ "$phase" = "scope-delete" ]; then
    # Scopes created before the attribute existed, or whose create failed on
    # it, must still be deletable: read the account back from the scope's
    # own origin once the profile is known (below).
    origin_lookup="true"
  elif [ -z "$assets_storage_account" ]; then
    echo ""
    echo "   ❌ azure_assets_storage_account is missing"
    echo ""
    echo "  💡 Possible causes:"
    echo "    • The scope configuration predates scope-level Front Door resources"
    echo ""
    echo "  🔧 How to fix:"
    echo "    • Set distribution.azure_assets_storage_account in the scope-configurations provider"
    echo "    • Or set AZURE_ASSETS_STORAGE_ACCOUNT in the agent"
    echo ""
    exit 1
  fi
  distribution_storage_account="$assets_storage_account"
  distribution_container_name="\$web"
  distribution_blob_prefix="/_not-deployed/$distribution_app_name"
else
  asset_url=$(echo "$CONTEXT" | jq -r .asset.url)

  # =============================================================================
  # Asset location
  # Format: https://<account>.blob.core.windows.net/<container>/<prefix>
  # CI may percent-encode the container ($web arrives as %24web).
  # =============================================================================
  if [[ "$asset_url" == https://*.blob.core.windows.net/* ]]; then
    url_without_scheme="${asset_url#https://}"
    distribution_storage_account="${url_without_scheme%%.*}"
    url_path="${url_without_scheme#*/}"
    distribution_container_name="${url_path%%/*}"
    distribution_container_name="${distribution_container_name//%24/\$}"
    remaining_path="${url_path#*/}"
    if [ "$remaining_path" = "$url_path" ]; then
      distribution_blob_prefix="/"
    else
      distribution_blob_prefix="/${remaining_path}"
    fi
  else
    echo ""
    echo "   ❌ Could not extract storage account from asset URL: $asset_url"
    echo ""
    echo "  💡 Possible causes:"
    echo "    • The asset URL format is not recognized"
    echo "    • CI registered the asset with something other than the blob URL"
    echo ""
    echo "  🔧 How to fix:"
    echo "    • Register the asset with 'https://<account>.blob.core.windows.net/<container>/<prefix>'"
    echo ""
    exit 1
  fi
fi

distribution_container_name=${distribution_container_name:-"\$web"}

if [ "$distribution_container_name" != "\$web" ]; then
  echo ""
  echo "   ❌ Container '$distribution_container_name' cannot be served by Front Door: the static-website origin only serves the \$web container"
  echo ""
  echo "  💡 Possible causes:"
  echo "    • CI uploaded the bundle to a regular blob container"
  echo ""
  echo "  🔧 How to fix:"
  echo "    • Upload the bundle to the \$web container and register the asset with 'https://<account>.blob.core.windows.net/\$web/<prefix>'"
  echo ""
  exit 1
fi

if [ -n "$assets_storage_account" ] && [ "$assets_storage_account" != "$distribution_storage_account" ]; then
  echo ""
  echo "   ❌ The asset is in storage account '$distribution_storage_account', but the scope serves '$assets_storage_account'"
  echo ""
  echo "  💡 Possible causes:"
  echo "    • CI uploaded the bundle to a different storage account"
  echo ""
  echo "  🔧 How to fix:"
  echo "    • Upload the bundle to '$assets_storage_account', or update distribution.azure_assets_storage_account"
  echo ""
  exit 1
fi

echo "   ✅ storage_account=${distribution_storage_account:-"(read from the scope's origin)"}"
echo "   ✅ container=$distribution_container_name"
echo "   ✅ blob_prefix=${distribution_blob_prefix:-"(root)"}"

# =============================================================================
# Shared Front Door profile and endpoint (customer-owned prerequisites)
# =============================================================================
missing_vars=()

distribution_front_door_profile=$(get_config_value \
  --provider '.providers["scope-configurations"].distribution.azure_front_door_profile' \
  --env AZURE_FRONT_DOOR_PROFILE)
if [ -z "$distribution_front_door_profile" ]; then
  echo "   ❌ azure_front_door_profile is missing"
  missing_vars+=("distribution.azure_front_door_profile")
else
  echo "   ✅ front_door_profile=$distribution_front_door_profile"
fi

distribution_front_door_endpoint=$(get_config_value \
  --provider '.providers["scope-configurations"].distribution.azure_front_door_endpoint' \
  --env AZURE_FRONT_DOOR_ENDPOINT)
if [ -z "$distribution_front_door_endpoint" ]; then
  echo "   ❌ azure_front_door_endpoint is missing"
  missing_vars+=("distribution.azure_front_door_endpoint")
else
  echo "   ✅ front_door_endpoint=$distribution_front_door_endpoint"
fi

if [ ${#missing_vars[@]} -gt 0 ]; then
  echo ""
  echo "  💡 Possible causes:"
  echo "    • The scope-configurations provider is missing these fields"
  echo ""
  echo "  🔧 How to fix:"
  echo "    Set the missing field(s) in the scope-configurations provider:"
  for var in "${missing_vars[@]}"; do
    echo "      • $var"
  done
  echo "    Or set AZURE_FRONT_DOOR_PROFILE / AZURE_FRONT_DOOR_ENDPOINT in the agent"
  echo ""
  exit 1
fi

provider_resource_group=$(get_config_value \
  --provider '.providers["scope-configurations"].provider.azure_resource_group' \
  --env AZURE_RESOURCE_GROUP)
distribution_front_door_resource_group=$(get_config_value \
  --provider '.providers["scope-configurations"].distribution.azure_front_door_resource_group' \
  --env AZURE_FRONT_DOOR_RESOURCE_GROUP \
  --default "$provider_resource_group")
echo "   ✅ front_door_resource_group=$distribution_front_door_resource_group"

subscription_id=$(get_config_value \
  --provider '.providers["scope-configurations"].provider.azure_subscription_id' \
  --env AZURE_SUBSCRIPTION_ID)

# =============================================================================
# Scope deletion without azure_assets_storage_account: the scope's origin
# holds the account. No origin means the scope never created its resources.
# =============================================================================
if [ "${origin_lookup:-false}" = "true" ]; then
  origin_url="https://management.azure.com/subscriptions/${subscription_id}/resourceGroups/${distribution_front_door_resource_group}/providers/Microsoft.Cdn/profiles/${distribution_front_door_profile}/originGroups/${distribution_app_name}-og/origins/${distribution_app_name}-origin?api-version=2025-04-15"

  origin_stderr_file=$(mktemp)
  origin_output=$(az rest --method get --url "$origin_url" 2>"$origin_stderr_file") && origin_exit_code=0 || origin_exit_code=$?
  origin_stderr=$(cat "$origin_stderr_file")
  rm -f "$origin_stderr_file"

  if [ "$origin_exit_code" -ne 0 ]; then
    if echo "$origin_stderr" | grep -q "ResourceNotFound\|NotFound\|ParentResourceNotFound"; then
      echo "   ⏭️  The scope has no Front Door origin: nothing to destroy"
      TOFU_ACTION="skip"
      export TOFU_ACTION
      # Sourced by layer_executor: stop this setup, later steps see the skip.
      # shellcheck disable=SC2317
      return 0 2>/dev/null || exit 0
    fi
    echo ""
    echo "   ❌ Failed to read the scope's Front Door origin"
    echo ""
    echo "  🔧 How to fix:"
    echo "    • Set distribution.azure_assets_storage_account in the scope-configurations provider"
    echo ""
    echo "  📋 Error details:"
    # shellcheck disable=SC2001
    echo "$origin_stderr" | sed 's/^/    /'
    echo ""
    exit 1
  fi

  origin_host=$(echo "$origin_output" | jq -r '.properties.hostName // empty')
  distribution_storage_account="${origin_host%%.*}"
  if [ -z "$distribution_storage_account" ]; then
    echo "   ❌ The scope's Front Door origin has no host name"
    echo "  🔧 How to fix: set distribution.azure_assets_storage_account in the scope-configurations provider"
    exit 1
  fi
  echo "   ✅ storage_account=$distribution_storage_account (from the scope's origin)"
fi

# =============================================================================
# Cache behavior
# =============================================================================
distribution_cached_path_prefixes=$(echo "$CONTEXT" | jq -c '
  (.providers["scope-configurations"].distribution.azure_front_door_cached_path_prefixes // [])
  | [(if type == "array" then .[] else . end) | select(. != "")]
  | if length == 0 then ["/static/"] else . end')

invalid_prefix=$(echo "$distribution_cached_path_prefixes" | jq -r '[.[] | select((type != "string") or (startswith("/") | not))][0] // empty')
if [ -n "$invalid_prefix" ]; then
  echo ""
  echo "   ❌ Cached path prefix '$invalid_prefix' must start with '/'"
  echo ""
  echo "  💡 Possible causes:"
  echo "    • distribution.azure_front_door_cached_path_prefixes has an entry without the leading slash"
  echo ""
  echo "  🔧 How to fix:"
  echo "    • Write every prefix as an absolute path, e.g. '/static/' or '/assets/'"
  echo ""
  exit 1
fi

prefix_count=$(echo "$distribution_cached_path_prefixes" | jq 'length')
if [ "$prefix_count" -gt 10 ]; then
  echo ""
  echo "   ❌ At most 10 cached path prefixes are allowed, got $prefix_count"
  echo ""
  echo "  💡 Possible causes:"
  echo "    • distribution.azure_front_door_cached_path_prefixes lists more prefixes than a Front Door rule condition accepts"
  echo ""
  echo "  🔧 How to fix:"
  echo "    • Group the cached files under fewer top-level folders"
  echo ""
  exit 1
fi
echo "   ✅ cached_path_prefixes=$(echo "$distribution_cached_path_prefixes" | jq -r 'join(",")')"

distribution_cache_days=$(echo "$CONTEXT" | jq -r '.providers["scope-configurations"].distribution.azure_front_door_cache_days // 7')
if ! [[ "$distribution_cache_days" =~ ^[0-9]+$ ]] || [ "$distribution_cache_days" -lt 1 ] || [ "$distribution_cache_days" -gt 365 ]; then
  echo ""
  echo "   ❌ azure_front_door_cache_days must be an integer between 1 and 365, got '$distribution_cache_days'"
  echo ""
  echo "  💡 Possible causes:"
  echo "    • distribution.azure_front_door_cache_days is out of range or not a whole number of days"
  echo ""
  echo "  🔧 How to fix:"
  echo "    • Set distribution.azure_front_door_cache_days to a whole number from 1 to 365, or remove it to use 7"
  echo ""
  exit 1
fi
distribution_cache_days=$((10#$distribution_cache_days))
echo "   ✅ cache_days=$distribution_cache_days"

# =============================================================================
# Security headers (off by default)
# =============================================================================
distribution_security_headers=$(echo "$CONTEXT" | jq -r '
  (.providers["scope-configurations"].distribution.azure_front_door_security_headers // false)
  | if . == true or . == "true" then "true" else "false" end')
distribution_content_security_policy=$(echo "$CONTEXT" | jq -r '.providers["scope-configurations"].distribution.azure_front_door_content_security_policy // ""')

if [ "$distribution_security_headers" = "true" ]; then
  echo "   ✅ security_headers=true"
  if [ -n "$distribution_content_security_policy" ]; then
    echo "   ✅ content_security_policy=$distribution_content_security_policy"
  fi
else
  if [ -n "$distribution_content_security_policy" ]; then
    echo "   ⚠️  azure_front_door_content_security_policy is ignored: azure_front_door_security_headers is off"
  fi
  distribution_content_security_policy=""
fi

# =============================================================================
# Custom domain certificate: a Front Door secret in the shared profile that
# points to a Key Vault certificate (empty = Front Door managed certificate)
# =============================================================================
distribution_certificate_secret=$(get_config_value \
  --provider '.providers["scope-configurations"].distribution.azure_front_door_certificate_secret' \
  --env AZURE_FRONT_DOOR_CERTIFICATE_SECRET)

if [ -n "$distribution_certificate_secret" ]; then
  # Length checked apart: POSIX regex bounds stop at 255 (RE_DUP_MAX).
  if ! [[ "$distribution_certificate_secret" =~ ^[A-Za-z0-9][A-Za-z0-9-]+$ ]] || [ ${#distribution_certificate_secret} -gt 260 ]; then
    echo ""
    echo "   ❌ azure_front_door_certificate_secret '$distribution_certificate_secret' is not a valid Front Door secret name"
    echo ""
    echo "  💡 Possible causes:"
    echo "    • distribution.azure_front_door_certificate_secret has characters other than letters, digits and hyphens"
    echo "    • The name starts with a hyphen or is shorter than 2 or longer than 260 characters"
    echo ""
    echo "  🔧 How to fix:"
    echo "    • Set it to the name of the Front Door secret in profile '$distribution_front_door_profile' (the requirements module output front_door_certificate_secret_name)"
    echo "    • Or remove it to use a Front Door managed certificate"
    echo ""
    exit 1
  fi
  echo "   ✅ certificate_secret=$distribution_certificate_secret"
else
  echo "   ✅ certificate=managed"
fi

# =============================================================================
# Preflight: the shared endpoint must already exist
# =============================================================================
echo ""
echo "   📡 Verifying Front Door endpoint..."

endpoint_url="https://management.azure.com/subscriptions/${subscription_id}/resourceGroups/${distribution_front_door_resource_group}/providers/Microsoft.Cdn/profiles/${distribution_front_door_profile}/afdEndpoints/${distribution_front_door_endpoint}?api-version=2025-04-15"

stderr_file=$(mktemp)
az_output=$(az rest --method get --url "$endpoint_url" 2>"$stderr_file") && az_exit_code=0 || az_exit_code=$?
az_stderr=$(cat "$stderr_file")
rm -f "$stderr_file"

if [ "$az_exit_code" -ne 0 ]; then
  echo ""
  if echo "$az_stderr" | grep -q "ResourceNotFound\|NotFound\|ParentResourceNotFound"; then
    echo "   ❌ Front Door endpoint '$distribution_front_door_endpoint' was not found in profile '$distribution_front_door_profile' (resource group '$distribution_front_door_resource_group')"
    echo ""
    echo "  💡 Possible causes:"
    echo "    • The shared profile or endpoint has not been created yet"
    echo "    • The names in the scope configuration have a typo"
    echo ""
    echo "  🔧 How to fix:"
    echo "    • Create them once per environment:"
    echo "        az afd profile create --resource-group $distribution_front_door_resource_group --profile-name $distribution_front_door_profile --sku Standard_AzureFrontDoor"
    echo "        az afd endpoint create --resource-group $distribution_front_door_resource_group --profile-name $distribution_front_door_profile --endpoint-name $distribution_front_door_endpoint --enabled-state Enabled"
  elif echo "$az_stderr" | grep -q "AuthorizationFailed\|Forbidden\|403"; then
    echo "   🔒 Error: Permission denied when reading the Front Door endpoint"
    echo ""
    echo "  🔧 How to fix:"
    echo "    • Grant the agent identity 'CDN Profile Contributor' on resource group '$distribution_front_door_resource_group'"
  else
    echo "   ❌ Failed to read the Front Door endpoint"
    echo ""
    echo "  📋 Error details:"
    # shellcheck disable=SC2001
    echo "$az_stderr" | sed 's/^/    /'
  fi
  echo ""
  exit 1
fi

endpoint_host=$(echo "$az_output" | jq -r '.properties.hostName // empty')
echo "   ✅ endpoint_host=${endpoint_host:-"(unknown)"}"

RESOURCE_TAGS_JSON=${RESOURCE_TAGS_JSON:-"{}"}

TOFU_VARIABLES=$(echo "$TOFU_VARIABLES" | jq \
  --arg storage_account "$distribution_storage_account" \
  --arg container_name "$distribution_container_name" \
  --arg app_name "$distribution_app_name" \
  --arg blob_prefix "$distribution_blob_prefix" \
  --argjson resource_tags_json "$RESOURCE_TAGS_JSON" \
  --arg fd_profile "$distribution_front_door_profile" \
  --arg fd_endpoint "$distribution_front_door_endpoint" \
  --arg fd_resource_group "$distribution_front_door_resource_group" \
  --argjson cached_path_prefixes "$distribution_cached_path_prefixes" \
  --argjson cache_days "$distribution_cache_days" \
  --argjson security_headers "$distribution_security_headers" \
  --arg content_security_policy "$distribution_content_security_policy" \
  --arg certificate_secret "$distribution_certificate_secret" \
  '. + {
    distribution_storage_account: $storage_account,
    distribution_container_name: $container_name,
    distribution_app_name: $app_name,
    distribution_blob_prefix: $blob_prefix,
    distribution_resource_tags_json: $resource_tags_json,
    distribution_front_door_profile: $fd_profile,
    distribution_front_door_endpoint: $fd_endpoint,
    distribution_front_door_resource_group: $fd_resource_group,
    distribution_cached_path_prefixes: $cached_path_prefixes,
    distribution_cache_days: $cache_days,
    distribution_security_headers: $security_headers,
    distribution_content_security_policy: $content_security_policy,
    distribution_certificate_secret: $certificate_secret
  }')

echo ""
echo "✨ Azure Front Door distribution configured successfully"
echo ""

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
module_name="${script_dir}/modules"

if [[ -n $MODULES_TO_USE ]]; then
  MODULES_TO_USE="$MODULES_TO_USE,$module_name"
else
  MODULES_TO_USE="$module_name"
fi
